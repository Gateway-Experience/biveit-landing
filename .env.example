# Base URL of the biveit web app (log in, projects, pricing and policy pages live there)
PUBLIC_APP_URL=http://localhost:5174
# Base URL of the biveit API. Used to tell whether a visitor is signed in, so they go straight to the app.
# The API must list this site's origin in its CORS_ALLOWED_ORIGINS.
PUBLIC_API_BASE_URL=http://localhost:3002/api
# This site's own public address: used for canonical links, hreflang, the sitemap and preview images.
PUBLIC_SITE_URL=https://biveit.com
