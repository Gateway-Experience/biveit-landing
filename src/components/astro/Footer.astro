---
import { Image } from 'astro:assets'
import logo from 'src/assets/brand/biveit-logo.png'
import { LANDING_WIDTH_CLASS } from 'src/components/pages/landing/landingData'
import { translate } from 'src/i18n/i18n'
import { APP_COOKIE_POLICY_URL, APP_PRICING_URL, APP_PRIVACY_URL } from 'src/utils/appUrls'
import { APP_NAME, type LanguageCode } from 'src/utils/constants'

// The landing page's footer (the app's PublicLayout has a matching one). Pricing and the policies live in the app.
interface Props {
  lang: LanguageCode
}

const { lang } = Astro.props
---

<footer class="border-t bg-card text-muted-foreground">
  <div class:list={[LANDING_WIDTH_CLASS, 'flex flex-col items-center justify-between gap-3 py-6 text-sm sm:flex-row']}>
    <div class="flex items-center gap-2">
      <Image src={logo} height={48} format="webp" quality={90} alt="" class="h-6 w-auto" />
      {translate(lang, 'landing_footer_rights', { year: new Date().getFullYear(), appName: APP_NAME })}
    </div>
    <nav class="flex items-center gap-4">
      <a href={APP_PRICING_URL} class="hover:text-foreground">{translate(lang, 'pricing_nav')}</a>
      <a href={APP_PRIVACY_URL} class="hover:text-foreground">{translate(lang, 'landing_footer_privacy')}</a>
      <a href={APP_COOKIE_POLICY_URL} class="hover:text-foreground">{translate(lang, 'cookie_policy_title')}</a>
    </nav>
  </div>
</footer>
